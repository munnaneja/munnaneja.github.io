<script>
// ---------- config ----------
const AMEN_R = 4000, OUT_R = 12000, PARK_R = 3500, RESERVE_R = 8000;
const OVERPASS = [
  "https://overpass-api.de/api/interpreter",
  "https://overpass.kumi.systems/api/interpreter",
  "https://overpass.private.coffee/api/interpreter"
];
const MODES = {
  walk: {label:"Walk", ico:"🚶", mpm:80,  reachMin:12, unit:"walk",  best:5, worst:30},
  bike: {label:"Bike", ico:"🚲", mpm:250, reachMin:12, unit:"bike",  best:4, worst:20},
  car:  {label:"Car",  ico:"🚗", mpm:500, reachMin:12, unit:"drive", best:3, worst:15}
};
const FACTORS = [
  {key:"gym",   label:"Gym",        ico:"🏋️", type:"nearest"},
  {key:"food",  label:"Food",       ico:"🍽️", type:"count", target:15},
  {key:"night", label:"Nightlife",  ico:"🍸",  type:"count", target:8},
  {key:"groc",  label:"Groceries",  ico:"🛒",  type:"nearest"},
  {key:"work",  label:"Café / work",ico:"☕",  type:"count", target:6},
  {key:"quiet", label:"Quiet",      ico:"😴",  type:"quiet"},
  {key:"out",   label:"Outdoors",   ico:"🏔️", type:"outdoors"},
  {key:"price", label:"Price",      ico:"💲",  type:"region", est:true},
  {key:"safety",label:"Safety",     ico:"🛡️", type:"region", est:true}
];
const EXAMPLES = ["Bethesda, Maryland","Alfama, Lisbon","Canggu, Bali","Antigua, Guatemala","San Francisco, CA"];

// outdoors distance thresholds (metres): great<=g (score 100), >=z (score 0)
const OUT_GOOD = { beach:{g:2000,z:OUT_R}, peak:{g:3000,z:OUT_R}, park:{g:600,z:PARK_R}, reserve:{g:3000,z:RESERVE_R} };
const KIND_LABEL = { beach:"Beach", peak:"Peak", park:"Park", reserve:"Reserve" };

// regional cost-of-living + safety indices — approximate snapshot, NOT live.
// c: cost of living (~NYC=100, higher = pricier). s: safety index 0-100 (higher = safer).
const REGION = {
  US:{c:70,s:53}, CA:{c:67,s:57}, MX:{c:36,s:44}, GT:{c:34,s:39}, PT:{c:50,s:70}, ES:{c:50,s:67},
  FR:{c:64,s:52}, DE:{c:62,s:63}, GB:{c:67,s:56}, IT:{c:58,s:57}, NL:{c:67,s:66}, CH:{c:104,s:78},
  TH:{c:38,s:60}, ID:{c:35,s:54}, VN:{c:36,s:56}, CO:{c:33,s:44}, BR:{c:37,s:38}, AR:{c:37,s:43},
  JP:{c:60,s:78}, AU:{c:73,s:57}, NZ:{c:70,s:60}, IN:{c:25,s:56}, PL:{c:45,s:72}, CZ:{c:50,s:74},
  GR:{c:52,s:60}, TR:{c:36,s:60}, AE:{c:62,s:84}, ZA:{c:39,s:24}, EG:{c:28,s:50}, MA:{c:34,s:56},
  PH:{c:37,s:45}, MY:{c:39,s:56}, SG:{c:81,s:78}, KR:{c:62,s:74}, CR:{c:50,s:55}, PA:{c:49,s:48},
  PE:{c:34,s:44}, CL:{c:46,s:52}, IE:{c:70,s:57}, BE:{c:63,s:56}, AT:{c:62,s:73}, SE:{c:65,s:56},
  NO:{c:84,s:66}, DK:{c:75,s:74}, HU:{c:43,s:70}, RO:{c:40,s:69}, HR:{c:48,s:73}, GE:{c:34,s:74}
};
const CITY_OVERRIDE = {
  "san francisco":{c:104,s:40}, "new york":{c:100,s:54}, "los angeles":{c:82,s:44}, "miami":{c:80,s:46},
  "london":{c:82,s:52}, "paris":{c:74,s:48}, "zurich":{c:118,s:80}, "geneva":{c:112,s:78},
  "singapore":{c:81,s:78}, "tokyo":{c:66,s:78}, "sydney":{c:80,s:57}, "dubai":{c:62,s:84},
  "lisbon":{c:52,s:70}, "mexico city":{c:42,s:38}, "amsterdam":{c:74,s:65}, "barcelona":{c:55,s:62},
  "bali":{c:36,s:56}, "canggu":{c:38,s:56}, "antigua":{c:36,s:46}
};
const DEFAULT_REGION = {c:55,s:50};

// state
const weights = {gym:1,food:1,night:1,groc:1,work:1,quiet:1,out:1,price:1,safety:1};
const WLABEL = {0:"Skip",1:"Matters",2:"High"};
let mode = "walk";
let cache = null;        // { geo, els:[amenities], out:[outdoor features], region:{c,s,basis} }
let selected = null;

// ---------- helpers ----------
const $ = s => document.querySelector(s);
function haversine(a,b){
  const R=6371000, t=Math.PI/180;
  const dLat=(b.lat-a.lat)*t, dLon=(b.lon-a.lon)*t, la1=a.lat*t, la2=b.lat*t;
  const x=Math.sin(dLat/2)**2+Math.cos(la1)*Math.cos(la2)*Math.sin(dLon/2)**2;
  return 2*R*Math.asin(Math.sqrt(x));
}
const clamp=(n,a,b)=>Math.max(a,Math.min(b,n));
function timeScore(min,best,worst){ if(min==null) return 0; if(min<=best) return 100; if(min>=worst) return 0; return Math.round((worst-min)/(worst-best)*100); }
function countScore(n,target){ return Math.round(clamp(n/target,0,1)*100); }
function quietScore(walkMin){ if(walkMin==null) return 100; if(walkMin>=8) return 100; if(walkMin<=0.5) return 6; return Math.round(walkMin/8*100); }
function distScore(d,g,z){ if(d==null) return 0; if(d<=g) return 100; if(d>=z) return 0; return Math.round((z-d)/(z-g)*100); }
function fmtKm(m){ return m>=1000? (m/1000).toFixed(m<10000?1:0)+" km" : Math.round(m)+" m"; }
function shortName(g){
  const a=g.address||{};
  const place=a.neighbourhood||a.suburb||a.city_district||a.quarter||a.hamlet||a.city||a.town||a.village||a.road||g.name||(g.display_name||"").split(",")[0];
  const city=a.city||a.town||a.village||a.municipality||a.county||a.state||"";
  return {lat:+g.lat, lon:+g.lon, place, city, cc:(a.country_code||"").toUpperCase(), country:a.country||"", full:g.display_name};
}
function regionFor(geo){
  const keys=[geo.place,geo.city,geo.country].filter(Boolean).map(x=>x.toLowerCase());
  for(const k of keys){ if(CITY_OVERRIDE[k]) return {...CITY_OVERRIDE[k], basis:(geo.place||geo.city)+" (city est.)"}; }
  if(geo.cc && REGION[geo.cc]) return {...REGION[geo.cc], basis:(geo.country||geo.cc)+" (country est.)"};
  return {...DEFAULT_REGION, basis:"global avg (est.)"};
}
function affordScore(c){ return clamp(Math.round((108-c)/78*100),0,100); }   // cheaper => higher
function costTier(c){ return c<40?"$":c<58?"$$":c<80?"$$$":"$$$$"; }
function costWord(c){ return c<40?"cheap":c<58?"moderate":c<80?"pricey":"expensive"; }
function safetyWord(s){ return s>=72?"Very safe":s>=58?"Safe":s>=42?"Mixed":"Caution"; }

// ---------- build UI ----------
const exWrap=$("#examples");
EXAMPLES.forEach(e=>{ const b=document.createElement("button"); b.className="chip"; b.textContent=e; b.onclick=()=>{ selected=null; $("#addr").value=e; hideAC(); run(); }; exWrap.appendChild(b); });

const modeWrap=$("#modes");
Object.entries(MODES).forEach(([k,m])=>{
  const b=document.createElement("button"); b.className="mode"+(k===mode?" active":""); b.dataset.k=k;
  b.innerHTML=`<span class="mi">${m.ico}</span>${m.label}`;
  b.onclick=()=>{ mode=k; document.querySelectorAll(".mode").forEach(x=>x.classList.toggle("active",x.dataset.k===k)); if(cache) recompute(); };
  modeWrap.appendChild(b);
});

const prioWrap=$("#prios");
FACTORS.forEach(f=>{
  const row=document.createElement("div"); row.className="prio"; row.dataset.k=f.key;
  row.innerHTML=`<span class="pname"><span class="pico">${f.ico}</span>${f.label}${f.est?' <span class="esttag">est</span>':''}</span><span class="weight w1">${WLABEL[1]}</span>`;
  row.onclick=()=>{ weights[f.key]=(weights[f.key]+1)%3; paintPrio(f.key,row); if(cache) recompute(); };
  prioWrap.appendChild(row);
});
function paintPrio(k,row){ const w=weights[k], tag=row.querySelector(".weight"); tag.className="weight w"+w; tag.textContent=WLABEL[w]; row.classList.toggle("skip",w===0); }

$("#go").onclick=()=>{ hideAC(); run(); };

// ---------- autocomplete ----------
const acBox=$("#ac"); const addr=$("#addr");
let acItems=[], acActive=-1, acTimer=null, acSeq=0;
function hideAC(){ acBox.classList.remove("show"); acBox.innerHTML=""; acItems=[]; acActive=-1; }
function showACMsg(html){ acBox.innerHTML=`<div class="ac-msg">${html}</div>`; acBox.classList.add("show"); }
async function fetchAC(q){
  const seq=++acSeq;
  showACMsg(`<span class="ac-dot"></span>Searching…`);
  try{
    const url=`https://nominatim.openstreetmap.org/search?format=jsonv2&limit=6&accept-language=en&addressdetails=1&q=${encodeURIComponent(q)}`;
    const r=await fetch(url,{headers:{"Accept":"application/json"}});
    const j=await r.json();
    if(seq!==acSeq) return;
    if(!j.length){ showACMsg("No matches — try adding a city or country."); return; }
    renderAC(j.map(shortName));
  }catch(e){ if(seq===acSeq) showACMsg("Search unavailable — type the full place and hit Score."); }
}
function renderAC(items){
  acItems=items; acActive=-1;
  acBox.innerHTML=items.map((it,i)=>`<div class="ac-item" data-i="${i}"><span class="p">${it.place}${it.city&&it.city!==it.place?`, ${it.city}`:""}</span><span class="c">${(it.full||"").replace(/</g,"")}</span></div>`).join("");
  acBox.classList.add("show");
  acBox.querySelectorAll(".ac-item").forEach(el=>{ el.onclick=()=>pickAC(+el.dataset.i); });
}
function pickAC(i){
  const it=acItems[i]; if(!it) return;
  selected=it;
  addr.value=it.place+(it.city&&it.city!==it.place?`, ${it.city}`:"");
  hideAC(); run();
}
addr.addEventListener("input",()=>{
  selected=null;
  const q=addr.value.trim();
  clearTimeout(acTimer);
  if(q.length<3){ hideAC(); return; }
  acTimer=setTimeout(()=>fetchAC(q),280);
});
addr.addEventListener("keydown",e=>{
  if(!acBox.classList.contains("show")||!acItems.length){ if(e.key==="Enter"){ hideAC(); run(); } return; }
  if(e.key==="ArrowDown"){ e.preventDefault(); acActive=(acActive+1)%acItems.length; paintAC(); }
  else if(e.key==="ArrowUp"){ e.preventDefault(); acActive=(acActive-1+acItems.length)%acItems.length; paintAC(); }
  else if(e.key==="Enter"){ e.preventDefault(); if(acActive>=0) pickAC(acActive); else { hideAC(); run(); } }
  else if(e.key==="Escape"){ hideAC(); }
});
function paintAC(){ acBox.querySelectorAll(".ac-item").forEach((el,i)=>el.classList.toggle("active",i===acActive)); }
document.addEventListener("click",e=>{ if(!e.target.closest(".acwrap")) hideAC(); });

// ---------- data ----------
async function geocode(q){
  const url=`https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&accept-language=en&addressdetails=1&q=${encodeURIComponent(q)}`;
  const r=await fetch(url,{headers:{"Accept":"application/json"}});
  if(!r.ok) throw new Error("Geocoder unavailable ("+r.status+")");
  const j=await r.json();
  if(!j.length) throw new Error("Couldn't find that place. Try adding a city or country.");
  return shortName(j[0]);
}
async function overpass(lat,lon){
  // amenities and outdoors as separate sets, each output-capped to bound payload in dense areas
  const q=`[out:json][timeout:20];
  (
    nwr["leisure"~"^(fitness_centre|sports_centre|fitness_station)$"](around:${AMEN_R},${lat},${lon});
    nwr["amenity"="gym"](around:${AMEN_R},${lat},${lon});
    nwr["amenity"~"^(restaurant|fast_food|cafe|bar|pub|nightclub)$"](around:${AMEN_R},${lat},${lon});
    nwr["shop"~"^(supermarket|convenience|greengrocer)$"](around:${AMEN_R},${lat},${lon});
  )->.a;
  (
    nwr["natural"="beach"](around:${OUT_R},${lat},${lon});
    node["natural"="peak"](around:${OUT_R},${lat},${lon});
    nwr["leisure"="park"](around:${PARK_R},${lat},${lon});
    nwr["leisure"="nature_reserve"](around:${RESERVE_R},${lat},${lon});
  )->.o;
  .a out center 400;
  .o out center 150;`;
  // race all mirrors — first successful response wins
  const tries=OVERPASS.map(ep=>fetch(ep,{method:"POST",body:"data="+encodeURIComponent(q)}).then(async r=>{
    if(!r.ok) throw new Error("Overpass "+r.status);
    const j=await r.json(); return j.elements||[];
  }));
  try{ return await Promise.any(tries); }
  catch(e){ throw new Error("Map data servers are busy — wait a few seconds and retry."); }
}
function classify(t){
  if(t.leisure==="fitness_centre"||t.leisure==="sports_centre"||t.leisure==="fitness_station"||t.amenity==="gym") return {grp:"a",cat:"gym"};
  if(t.amenity==="restaurant"||t.amenity==="fast_food") return {grp:"a",cat:"food"};
  if(t.amenity==="cafe") return {grp:"a",cat:"work"};
  if(t.amenity==="bar"||t.amenity==="pub"||t.amenity==="nightclub") return {grp:"a",cat:"night"};
  if(t.shop==="supermarket"||t.shop==="convenience"||t.shop==="greengrocer") return {grp:"a",cat:"groc"};
  if(t.natural==="beach") return {grp:"o",kind:"beach"};
  if(t.natural==="peak") return {grp:"o",kind:"peak"};
  if(t.leisure==="park") return {grp:"o",kind:"park"};
  if(t.leisure==="nature_reserve") return {grp:"o",kind:"reserve"};
  return null;
}

// ---------- scoring ----------
function buildModel(){
  const M=MODES[mode];
  const reachDist=Math.min(M.mpm*M.reachMin, AMEN_R);
  const cats={gym:[],food:[],work:[],night:[],groc:[]};
  cache.els.forEach(e=>cats[e.cat].push(e));
  Object.values(cats).forEach(a=>a.sort((x,y)=>x._m-y._m));
  const nearMin = arr => arr.length? arr[0]._m/M.mpm : null;
  const nearWalk= arr => arr.length? arr[0]._m/80   : null;
  const inReach = arr => arr.filter(x=>x._m<=reachDist).length;

  const f={};
  f.gym  ={score:timeScore(nearMin(cats.gym),M.best,M.worst), min:nearMin(cats.gym)};
  f.food ={score:countScore(inReach(cats.food),15),  n:inReach(cats.food)};
  f.night={score:countScore(inReach(cats.night),8),  n:inReach(cats.night)};
  f.groc ={score:timeScore(nearMin(cats.groc),M.best,M.worst), min:nearMin(cats.groc)};
  f.work ={score:countScore(inReach(cats.work),6),   n:inReach(cats.work)};
  f.quiet={score:quietScore(nearWalk(cats.night)),   min:nearWalk(cats.night)};

  // outdoors — best single nature access + a small variety bonus
  const groups={beach:[],peak:[],park:[],reserve:[]};
  cache.out.forEach(o=>groups[o.kind]&&groups[o.kind].push(o));
  Object.values(groups).forEach(a=>a.sort((x,y)=>x._m-y._m));
  let best={score:0,kind:null,d:null}, types=0;
  for(const k in groups){ const arr=groups[k]; if(!arr.length) continue; types++; const d=arr[0]._m, g=OUT_GOOD[k], s=distScore(d,g.g,g.z); if(s>best.score) best={score:s,kind:k,d}; }
  f.out={score:clamp(best.score+(types>1?(types-1)*5:0),0,100), kind:best.kind, d:best.d};

  // region estimates
  const rg=cache.region;
  f.price ={score:affordScore(rg.c), tier:costTier(rg.c), word:costWord(rg.c), basis:rg.basis};
  f.safety={score:rg.s, word:safetyWord(rg.s), idx:rg.s, basis:rg.basis};
  return {factors:f, reachMin:M.reachMin, unit:M.unit};
}
function overall(f){ let sw=0,acc=0; FACTORS.forEach(x=>{ const w=weights[x.key]; if(w>0){ acc+=f[x.key].score*w; sw+=w; } }); return sw?Math.round(acc/sw):0; }
function valueText(f,d,m){
  const u=m.unit, W=MODES[mode];
  if(f.key==="gym")   return d.min==null?`none ≤${W.worst} min`:`${Math.round(d.min)} min ${u}`;
  if(f.key==="groc")  return d.min==null?`none ≤${W.worst} min`:`${Math.round(d.min)} min ${u}`;
  if(f.key==="food")  return `${d.n} spots ≤${m.reachMin} min`;
  if(f.key==="night") return `${d.n} bars ≤${m.reachMin} min`;
  if(f.key==="work")  return `${d.n} cafés ≤${m.reachMin} min`;
  if(f.key==="quiet") return d.min==null?"no bars near":`nearest bar ${Math.round(d.min)} min walk`;
  if(f.key==="out")   return d.kind==null?"no nature ≤12 km":`${KIND_LABEL[d.kind]} ${fmtKm(d.d)}`;
  if(f.key==="price") return `${d.tier} · ${d.word}`;
  if(f.key==="safety")return `${d.word} · ${d.idx}`;
}
function verdictCopy(total,f,geo){
  const place=geo.place||"this spot";
  const ranked=FACTORS.filter(x=>weights[x.key]>0).map(x=>({...x,s:f[x.key].score})).sort((a,b)=>a.s-b.s);
  const worst=ranked[0], best=ranked[ranked.length-1];
  const by=MODES[mode].label.toLowerCase();
  if(total>=75) return `<b>${place} holds up by ${by}.</b> ${best?best.label.toLowerCase()+" is a strong point":"everything's close"} — book it with confidence.`;
  if(total>=60) return `<b>${place} is workable by ${by}.</b> Good on ${best?best.label.toLowerCase():"the basics"}, but ${worst&&worst.s<55?"weak on "+worst.label.toLowerCase():"check the details"} first.`;
  return `<b>Think twice on ${place} by ${by}.</b> ${worst?worst.label+" is the weak link":"the block is stranded"} — a different transport mode or area might change the verdict.`;
}

// ---------- render ----------
let map, layer, reachCircle;
function recompute(){ const model=buildModel(); renderTicket(cache.geo, model); updateReach(cache.geo); }
function renderTicket(geo, model){
  const total=overall(model.factors), m={unit:model.unit,reachMin:model.reachMin};
  const cls=total>=75?"pass-ok":total>=60?"pass-mid":"pass-bad";
  const stamp=total>=75?"Book it":total>=60?"Worth a look":"Think twice";
  const rows=FACTORS.map(f=>{
    const d=model.factors[f.key], skip=weights[f.key]===0, good=d.score>=65;
    return `<div class="frow ${skip?'skipped':''}"><div class="ftop"><span class="k"><span class="ic">${f.ico}</span>${f.label}${f.est?' <span class="esttag">est</span>':''}</span><span class="v">${valueText(f,d,m)}</span></div><div class="bar ${good?'good':'weak'}"><i style="width:${d.score}%"></i></div></div>`;
  }).join("");
  $("#status").style.display="none";
  const res=$("#result"); res.style.display="block";
  res.innerHTML=`<div class="ticket ${cls}">
    <div class="ticket-head"><span class="th-brand"><svg viewBox="0 0 32 32"><rect x="3" y="3" width="26" height="26" rx="5"/><path d="M10 16.5l4 4 8-9" stroke="#FFFDF8" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>Nomads Land Boarding Pass</span><span class="th-label">Location report · live</span></div>
    <div class="ticket-main">
      <div class="ticket-info">
        <div class="route"><span class="lbl">Location</span><span class="city">${geo.place||"This spot"}</span><span class="where">${geo.city&&geo.city!==geo.place?geo.city+" · ":""}${geo.country||(geo.full||"").split(",").slice(-1)[0].trim()}</span></div>
        <div class="ticket-sub"><span class="modepill">${MODES[mode].ico} by ${MODES[mode].label}</span> scored on ${FACTORS.filter(f=>weights[f.key]>0).length} priorities</div>
        <div class="factors">${rows}</div>
      </div>
      <div class="ticket-stub"><div class="stub-score"><span class="lbl">Stay Score</span><span class="n">${total}</span></div><div class="stub-stamp">${stamp}</div></div>
    </div>
    <div class="verdict">${verdictCopy(total,model.factors,geo)}</div>
  </div>`;
}
function ensureMap(){ if(!map){ map=L.map("map",{scrollWheelZoom:false}); L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",{maxZoom:19,attribution:"© OpenStreetMap"}).addTo(map);} }
function drawMarkers(geo){
  ensureMap();
  if(layer) layer.remove(); layer=L.layerGroup().addTo(map);
  const colors={gym:"#A8500F",food:"#2E6FB0",night:"#8E44AD",groc:"#16887A",work:"#C99700"};
  L.circleMarker([geo.lat,geo.lon],{radius:9,color:"#fff",weight:3,fillColor:"#2E5240",fillOpacity:1}).addTo(layer).bindPopup("<b>Your spot</b><br>"+(geo.place||""));
  cache.els.slice().sort((a,b)=>a._m-b._m).slice(0,220).forEach(x=>{
    L.circleMarker([x.lat,x.lon],{radius:5,color:"#fff",weight:1.5,fillColor:colors[x.cat],fillOpacity:.92}).addTo(layer).bindPopup(`<b>${x.name}</b><br>${x.cat}`);
  });
  cache.out.slice().sort((a,b)=>a._m-b._m).slice(0,60).forEach(x=>{
    L.circleMarker([x.lat,x.lon],{radius:5,color:"#fff",weight:1.5,fillColor:"#1F7A3F",fillOpacity:.92}).addTo(layer).bindPopup(`<b>${x.name}</b><br>${KIND_LABEL[x.kind]} · ${fmtKm(x._m)}`);
  });
  map.setView([geo.lat,geo.lon],14);
  setTimeout(()=>map.invalidateSize(),60);
}
function updateReach(geo){
  ensureMap();
  const reachDist=Math.min(MODES[mode].mpm*MODES[mode].reachMin, AMEN_R);
  if(reachCircle) reachCircle.remove();
  reachCircle=L.circle([geo.lat,geo.lon],{radius:reachDist,color:"#2E5240",weight:1.5,dashArray:"5 5",fillColor:"#2E5240",fillOpacity:.05}).addTo(map);
}

// ---------- flow ----------
function setStatus(html,err){ const s=$("#status"); s.style.display="block"; s.className="status"+(err?" err":""); s.innerHTML=html; $("#result").style.display="none"; $("#mapwrap").style.display="none"; }
let busy=false;
async function run(){
  if(busy) return;
  const q=$("#addr").value.trim();
  if(!q && !selected){ setStatus(`<div class="big">Enter a location first</div><div>Type a specific place and pick it from the list — e.g. "7000 Wisconsin Ave, Bethesda MD".</div>`,true); return; }
  busy=true; $("#go").disabled=true;
  setStatus(`<div class="spinner"></div><div class="big">Scoring the location…</div><div>${selected?"Pulling live amenities & outdoors from OpenStreetMap.":"Finding the place, then pulling live data."}</div>`);
  try{
    const geo = selected || await geocode(q);
    const raw = await overpass(geo.lat,geo.lon);
    const els=[], out=[];
    raw.forEach(e=>{
      const c=classify(e.tags||{}); if(!c) return;
      const lat=e.lat??(e.center&&e.center.lat), lon=e.lon??(e.center&&e.center.lon);
      if(lat==null||lon==null) return;
      const _m=haversine(geo,{lat,lon}), name=(e.tags&&e.tags.name)||(c.cat||c.kind);
      if(c.grp==="a") els.push({lat,lon,cat:c.cat,name,_m});
      else out.push({lat,lon,kind:c.kind,name,_m});
    });
    cache={geo, els, out, region:regionFor(geo)};
    $("#mapwrap").style.display="block";
    drawMarkers(geo);
    recompute();
  }catch(e){
    setStatus(`<div class="big">Couldn't score that</div><div>${(e&&e.message)||e}</div><div style="margin-top:10px;font-size:13px">Tip: OSM's free servers throttle sometimes — wait a few seconds and retry.</div>`,true);
  }finally{ busy=false; $("#go").disabled=false; }
}
</script>
