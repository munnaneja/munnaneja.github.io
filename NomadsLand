<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nomads Land | Score any location before you book</title>
<meta name="description" content="Type a specific address or place. Nomads Land pulls real nearby amenities and outdoors from OpenStreetMap, adds regional price & safety, and scores it by how you get around — before you pay.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect x='3' y='3' width='26' height='26' rx='5' fill='%232E5240'/%3E%3Cpath d='M10 16.5l4 4 8-9' stroke='%23F4F2EC' stroke-width='3' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@500;600;700;800;900&family=Newsreader:opsz,wght@6..72,600;6..72,700&family=Spline+Sans+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<style>
:root{
  --paper:#F4F2EC; --paper-deep:#ECE9E0; --ink:#191811; --ink-soft:#5F5A4E;
  --line:#DAD5C7; --line-soft:#E6E2D6; --green:#2E5240; --green-soft:#E3EBE2;
  --amber:#A8500F; --amber-soft:#F4E5D6; --plane:#2E6FB0; --sky:#D2E5F2;
  --mono:'Spline Sans Mono',ui-monospace,monospace;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Figtree',system-ui,sans-serif;background:var(--paper);color:var(--ink);font-size:17px;line-height:1.5;font-weight:500;-webkit-font-smoothing:antialiased}
::selection{background:var(--green-soft);color:var(--green)}
a{color:inherit}
button:focus-visible,input:focus-visible{outline:3px solid var(--green);outline-offset:3px}
.wrap{max-width:1080px;margin:0 auto;padding:0 24px}

.dochead{border-bottom:1px solid var(--line);background:var(--sky)}
.dochead .wrap{display:flex;justify-content:space-between;align-items:center;height:46px;font-family:var(--mono);font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:#3F566B;font-weight:500}
.dochead b{color:var(--ink);font-weight:700}
header.app{background:linear-gradient(180deg,var(--sky) 0%,#E3EEF5 55%,var(--paper) 100%);border-bottom:1px solid var(--line);padding:34px 0 38px}
.wordmark{font-family:'Newsreader',serif;font-weight:700;font-size:30px;letter-spacing:-.01em;display:flex;align-items:center;gap:11px}
.wordmark svg{width:30px;height:30px}
.kicker{font-family:var(--mono);font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--plane);font-weight:700;margin:18px 0 8px}
header.app h1{font-family:'Newsreader',serif;font-weight:700;font-size:clamp(30px,5vw,46px);line-height:1.03;letter-spacing:-.02em;max-width:20ch}
header.app p.lede{font-size:clamp(16px,2vw,19px);font-weight:700;color:#37506A;max-width:60ch;margin-top:12px}

main{padding:34px 0 90px}
.grid{display:grid;grid-template-columns:380px 1fr;gap:28px;align-items:start}
@media(max-width:880px){.grid{grid-template-columns:1fr}}

.panel{background:#FFFDF8;border:1px solid var(--line);border-radius:18px;padding:24px;box-shadow:0 2px 4px rgba(25,24,17,.05),0 24px 48px -34px rgba(25,24,17,.4);position:sticky;top:18px}
.panel h2{font-family:'Newsreader',serif;font-size:23px;font-weight:700;letter-spacing:-.01em;margin-bottom:4px}
.panel .sub{font-size:14.5px;color:var(--ink-soft);font-weight:600;margin-bottom:18px}
.field-lbl{display:block;font-family:var(--mono);font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-soft);font-weight:700;margin-bottom:7px}
.acwrap{position:relative}
.address{width:100%;font-family:'Figtree',sans-serif;font-size:16px;font-weight:600;padding:14px 15px;border:2px solid var(--line);border-radius:11px;background:#fff;color:var(--ink)}
.address::placeholder{color:#9AA7B2;font-weight:500}
.tip{font-size:12.5px;color:var(--ink-soft);font-weight:600;margin-top:8px;line-height:1.45}
.tip b{color:var(--green)}
.ac{position:absolute;top:calc(100% + 6px);left:0;right:0;background:#fff;border:1.5px solid var(--line);border-radius:12px;box-shadow:0 18px 40px -18px rgba(25,24,17,.45);z-index:60;overflow:hidden;display:none}
.ac.show{display:block}
.ac-item{padding:10px 14px;cursor:pointer;border-bottom:1px solid var(--line-soft);display:flex;flex-direction:column;gap:2px}
.ac-item:last-child{border-bottom:none}
.ac-item:hover,.ac-item.active{background:var(--green-soft)}
.ac-item .p{font-weight:800;font-size:14.5px}
.ac-item .c{font-size:12px;color:var(--ink-soft);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ac-msg{padding:11px 14px;font-size:13px;color:var(--ink-soft);font-weight:600;display:flex;align-items:center;gap:8px}
.ac-dot{width:13px;height:13px;border:2px solid var(--line);border-top-color:var(--green);border-radius:50%;animation:spin .7s linear infinite}
.examples{display:flex;flex-wrap:wrap;gap:7px;margin-top:11px}
.chip{font-family:var(--mono);font-size:11px;letter-spacing:.04em;border:1.5px solid var(--line);background:#fff;border-radius:999px;padding:6px 11px;cursor:pointer;font-weight:700;color:var(--ink-soft);transition:.15s}
.chip:hover{border-color:var(--green);color:var(--green);background:var(--green-soft)}
.modes{display:flex;gap:7px;margin-top:7px}
.mode{flex:1;border:1.5px solid var(--line);border-radius:11px;padding:10px 6px;text-align:center;cursor:pointer;font-weight:800;font-size:13.5px;background:#fff;transition:.15s;color:var(--ink-soft)}
.mode .mi{display:block;font-size:19px;margin-bottom:3px;line-height:1}
.mode:hover{border-color:var(--line-soft)}
.mode.active{border-color:var(--green);background:var(--green-soft);color:var(--green)}
.prio-head{margin:22px 0 10px;display:flex;justify-content:space-between;align-items:baseline}
.prio-head .field-lbl{margin:0}
.prio-head .hint{font-size:11.5px;color:var(--ink-soft);font-weight:600}
.block-lbl{margin:22px 0 7px}
.prios{display:flex;flex-direction:column;gap:8px}
.prio{display:flex;align-items:center;justify-content:space-between;gap:10px;border:1.5px solid var(--line-soft);border-radius:11px;padding:9px 13px;background:#fff;cursor:pointer;transition:.15s;user-select:none}
.prio:hover{border-color:var(--line)}
.prio .pname{font-weight:800;font-size:14.5px;display:flex;align-items:center;gap:9px}
.prio .pico{font-size:16px;line-height:1}
.prio .weight{font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;font-weight:700;border-radius:7px;padding:5px 9px;border:1.5px solid}
.weight.w0{color:#9AA7B2;border-color:var(--line)}
.weight.w1{color:var(--ink-soft);border-color:var(--line)}
.weight.w2{color:var(--green);border-color:var(--green);background:var(--green-soft)}
.prio.skip{opacity:.55}
.go{width:100%;margin-top:20px;background:var(--green);color:#F4F2EC;border:none;font-family:'Figtree',sans-serif;font-size:17px;font-weight:800;padding:15px;border-radius:12px;cursor:pointer;transition:background .2s}
.go:hover{background:#23402F}
.go:disabled{opacity:.5;cursor:not-allowed}

.stage{min-height:200px}
.status{background:#FFFDF8;border:1px dashed var(--line);border-radius:18px;padding:40px 28px;text-align:center;color:var(--ink-soft)}
.status.err{border-color:var(--amber);border-style:solid;color:var(--amber);background:var(--amber-soft)}
.status .big{font-family:'Newsreader',serif;font-size:23px;font-weight:700;color:var(--ink);margin-bottom:6px}
.status.err .big{color:var(--amber)}
.spinner{width:34px;height:34px;border:3px solid var(--line);border-top-color:var(--green);border-radius:50%;animation:spin .8s linear infinite;margin:0 auto 16px}
@keyframes spin{to{transform:rotate(360deg)}}

.ticket{background:#FFFDF8;border-radius:20px;overflow:hidden;box-shadow:0 2px 4px rgba(25,24,17,.06),0 30px 60px -34px rgba(25,24,17,.4);margin-bottom:24px}
.ticket-head{display:flex;align-items:center;gap:12px;padding:15px 24px;color:#fff;font-family:var(--mono);text-transform:uppercase}
.pass-ok .ticket-head{background:var(--green)}
.pass-mid .ticket-head{background:var(--plane)}
.pass-bad .ticket-head{background:var(--amber)}
.th-brand{font-weight:700;display:flex;align-items:center;gap:10px;font-size:14px;letter-spacing:.08em}
.th-brand svg{width:22px;height:22px;fill:currentColor}
.th-label{font-weight:500;font-size:12px;letter-spacing:.14em;margin-left:auto;opacity:.92}
.ticket-main{display:grid;grid-template-columns:1fr 232px}
@media(max-width:560px){.ticket-main{grid-template-columns:1fr}}
.ticket-info{padding:24px 26px}
.route .lbl{display:block;font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft);font-weight:600;margin-bottom:3px}
.route .city{font-family:'Newsreader',serif;font-size:clamp(23px,3.3vw,31px);font-weight:700;line-height:1.02;letter-spacing:-.01em}
.route .where{font-size:13px;color:var(--ink-soft);font-weight:600;margin-top:5px}
.ticket-sub{font-size:14.5px;font-weight:700;margin:15px 0 13px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.pass-ok .ticket-sub{color:var(--green)}
.pass-mid .ticket-sub{color:var(--plane)}
.pass-bad .ticket-sub{color:var(--amber)}
.modepill{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;background:var(--paper-deep);color:var(--ink-soft);border-radius:999px;padding:4px 10px;font-weight:700}
.factors{display:grid;grid-template-columns:1fr 1fr;gap:0 26px}
@media(max-width:560px){.factors{grid-template-columns:1fr}}
.frow{border-top:1px dashed var(--line);padding:10px 0}
.frow .ftop{display:flex;justify-content:space-between;align-items:baseline;gap:10px}
.frow .k{font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:.02em;display:flex;align-items:center;gap:6px}
.frow .k .ic{font-size:14px}
.esttag{font-family:var(--mono);font-size:8px;letter-spacing:.08em;background:var(--paper-deep);color:var(--ink-soft);border-radius:5px;padding:2px 4px;font-weight:700;text-transform:uppercase}
.frow .v{font-family:var(--mono);font-size:11px;font-weight:700;white-space:nowrap;color:var(--ink-soft);text-align:right}
.frow.skipped{opacity:.4}
.bar{height:6px;border-radius:4px;background:var(--line-soft);margin-top:6px;overflow:hidden}
.bar > i{display:block;height:100%;border-radius:4px;transition:width .35s ease}
.bar.good > i{background:var(--green)}
.bar.weak > i{background:var(--amber)}
.ticket-stub{position:relative;border-left:2px dashed var(--line);padding:24px 18px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;text-align:center;background:#FBFAF3}
.ticket-stub::before,.ticket-stub::after{content:"";position:absolute;left:-13px;width:26px;height:26px;border-radius:50%;background:var(--paper)}
.ticket-stub::before{top:-13px}.ticket-stub::after{bottom:-13px}
.stub-score .lbl{display:block;font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-soft);font-weight:600;margin-bottom:2px}
.stub-score .n{font-family:'Newsreader',serif;font-size:62px;font-weight:700;line-height:.9;letter-spacing:-.03em}
.pass-ok .n{color:var(--green)}.pass-mid .n{color:var(--plane)}.pass-bad .n{color:var(--amber)}
.stub-stamp{border:3px solid;border-radius:9px;padding:7px 14px;font-family:var(--mono);font-size:13px;letter-spacing:.14em;text-transform:uppercase;font-weight:700}
.pass-ok .stub-stamp{color:var(--green);border-color:var(--green);transform:rotate(-5deg)}
.pass-mid .stub-stamp{color:var(--plane);border-color:var(--plane);transform:rotate(-3deg)}
.pass-bad .stub-stamp{color:var(--amber);border-color:var(--amber);transform:rotate(4deg)}
.verdict{font-family:'Newsreader',serif;font-size:18px;font-weight:600;line-height:1.35;padding:18px 26px 22px;border-top:1px solid var(--line);color:var(--ink)}
.verdict b{color:var(--green)}

#map{height:340px;border-radius:18px;border:1px solid var(--line);overflow:hidden;box-shadow:0 2px 4px rgba(25,24,17,.05)}
.legend{display:flex;flex-wrap:wrap;gap:13px;margin-top:12px;font-family:var(--mono);font-size:11px;letter-spacing:.04em;color:var(--ink-soft);font-weight:700}
.legend span{display:inline-flex;align-items:center;gap:6px}
.dot{width:11px;height:11px;border-radius:50%;display:inline-block;border:2px solid #fff;box-shadow:0 0 0 1px rgba(0,0,0,.15)}
.foot{margin-top:30px;font-size:13px;color:var(--ink-soft);font-weight:600;line-height:1.6;border-top:1px solid var(--line);padding-top:18px}
.foot b{color:var(--ink)}
/* ===== shared site chrome (nav + footer) ===== */
.site-nav{position:sticky;top:0;z-index:120;background:rgba(244,242,236,.93);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.site-nav-inner{display:flex;align-items:center;justify-content:space-between;height:62px}
.site-brand{display:flex;align-items:center;gap:9px;font-family:'Newsreader',serif;font-weight:700;font-size:22px;letter-spacing:-.01em;text-decoration:none;color:var(--ink)}
.site-brand svg{width:24px;height:24px;flex:none}
.site-links{display:flex;align-items:center;gap:22px;list-style:none;margin:0;padding:0}
.site-links a{text-decoration:none;font-size:15px;font-weight:700;color:var(--ink-soft);transition:color .2s}
.site-links a:hover,.site-links a.active{color:var(--ink)}
.site-cta{background:var(--green);color:#F4F2EC !important;padding:10px 17px;border-radius:10px;font-size:14px;font-weight:800;white-space:nowrap}
.site-cta:hover{background:#23402F}
#score{scroll-margin-top:78px}
.site-foot{border-top:1px solid var(--line);background:var(--paper);padding:40px 0 52px}
.site-foot-inner{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;align-items:baseline}
.site-foot-brand{display:flex;align-items:center;gap:9px;font-family:'Newsreader',serif;font-weight:700;font-size:22px;color:var(--ink);text-decoration:none}
.site-foot-brand svg{width:22px;height:22px}
.site-foot-tag{font-size:14px;font-weight:600;color:var(--ink-soft);margin-top:6px}
.site-foot-links{display:flex;gap:22px;list-style:none;margin:0;padding:0;flex-wrap:wrap}
.site-foot-links a{font-size:14px;font-weight:600;color:var(--ink-soft);text-decoration:none}
.site-foot-links a:hover{color:var(--ink)}
.site-copy{font-family:var(--mono);font-size:11px;letter-spacing:.06em;color:#A29C8C;margin-top:16px;text-transform:uppercase;font-weight:500}
@media(max-width:560px){.site-links .hideSm{display:none}}
</style>
</head>
